<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainContainer" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stockmaster.controller.MainController">
   <left>
      <VBox minWidth="220" maxWidth="280" prefWidth="250.0" spacing="5.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <VBox.margin>
                  <Insets bottom="20.0" left="20.0" top="25.0" />
               </VBox.margin>
               <children>
                  <ImageView fitHeight="28.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/logo.png" />
                     </image>
                  </ImageView>
                  <Label text="StockMaster" textFill="WHITE">
                     <font>
                        <Font name="Segoe UI Bold" size="22.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <!-- Separator -->
            <HBox prefHeight="1" style="-fx-background-color: rgba(255,255,255,0.06);">
               <VBox.margin>
                  <Insets left="16.0" right="16.0" bottom="8.0" />
               </VBox.margin>
            </HBox>

            <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#showDashboard" prefHeight="44.0" prefWidth="250.0" styleClass="nav-button" text="📊  Dashboard" />
            <Button fx:id="btnSales" mnemonicParsing="false" onAction="#showSales" prefHeight="44.0" prefWidth="250.0" styleClass="nav-button" text="💰  Sales" />
            <Button fx:id="btnProducts" mnemonicParsing="false" onAction="#showProducts" prefHeight="44.0" prefWidth="250.0" styleClass="nav-button" text="📦  Products" />
            <Button fx:id="btnPurchaseOrders" mnemonicParsing="false" onAction="#showPurchaseOrders" prefHeight="44.0" prefWidth="250.0" styleClass="nav-button" text="📋  Purchase Orders" />
            <Button fx:id="btnCategories" mnemonicParsing="false" onAction="#showCategories" prefHeight="44.0" prefWidth="250.0" styleClass="nav-button" text="🗂  Categories" />
            <Button fx:id="btnSuppliers" mnemonicParsing="false" onAction="#showSuppliers" prefHeight="44.0" prefWidth="250.0" styleClass="nav-button" text="🚚  Suppliers" />
            <Button fx:id="btnReports" mnemonicParsing="false" onAction="#showReports" prefHeight="44.0" prefWidth="250.0" styleClass="nav-button" text="📈  Reports" />
            <Button fx:id="btnUsers" mnemonicParsing="false" onAction="#showUsers" prefHeight="44.0" prefWidth="250.0" styleClass="nav-button" text="👥  Users" />

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Backup/Restore -->
            <HBox spacing="6.0" alignment="CENTER_LEFT">
               <VBox.margin>
                  <Insets left="16.0" right="16.0" bottom="4.0" />
               </VBox.margin>
               <children>
                  <Button fx:id="btnBackup" text="💾 Backup" onAction="#handleBackup" prefHeight="30" style="-fx-font-size: 10px;" styleClass="nav-button" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnRestore" text="📂 Restore" onAction="#handleRestore" prefHeight="30" style="-fx-font-size: 10px;" styleClass="nav-button" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <!-- Language Selector -->
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <VBox.margin>
                  <Insets left="16.0" right="16.0" />
               </VBox.margin>
               <children>
                  <Label text="🌐" style="-fx-font-size: 14px;" />
                  <ComboBox fx:id="comboLanguage" prefWidth="150.0" style="-fx-font-size: 11px;" />
               </children>
            </HBox>

            <!-- Logout Button -->
            <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#handleLogout" prefWidth="250.0" styleClass="nav-button" 
                    text="🚪  Logout (Ctrl+Q)" style="-fx-text-fill: #ff6b6b;" />

            <!-- Status Bar -->
            <VBox styleClass="status-bar" spacing="4.0">
               <children>
                  <Label fx:id="lblUserInfo" text="User: —" />
                  <Label fx:id="lblStatusProducts" text="Products: —" />
                  <Label fx:id="lblVersion" text="v4.0 • StockMaster Enterprise" style="-fx-text-fill: #555566; -fx-font-size: 10px;" />
               </children>
            </VBox>
         </children>
      </VBox>
   </left>
   <center>
       <!-- Content will be loaded here -->
   </center>
</BorderPane>

