<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800.0" prefWidth="950.0" spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stockmaster.controller.CategoryController">
   <children>
      <Label styleClass="header-label" text="Category Management" />
      
      <!-- Toolbar -->
      <HBox spacing="10.0" alignment="CENTER_LEFT">
         <children>
             <Button text="Refresh" onAction="#handleRefresh" />
             <HBox HBox.hgrow="ALWAYS" />
             <Button text="Delete Selected" onAction="#handleDelete" style="-fx-background-color: #d70000;" />
         </children>
      </HBox>

      <!-- Main Content Split -->
      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
          <!-- Table -->
          <TableView fx:id="tableCategories" HBox.hgrow="ALWAYS">
              <columns>
                  <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                  <TableColumn fx:id="colName" text="Name" prefWidth="200" />
                  <TableColumn fx:id="colDescription" text="Description" prefWidth="300" />
              </columns>
              <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
              </columnResizePolicy>
          </TableView>

          <!-- Edit Form -->
          <VBox spacing="10.0" prefWidth="300.0" styleClass="card" style="-fx-padding: 15;">
             <children>
                 <Label text="Category Details" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                 
                 <Label text="Name" />
                 <TextField fx:id="txtName" />
                 
                 <Label text="Description" />
                 <TextArea fx:id="txtDescription" prefHeight="100.0" wrapText="true" />
                 
                 <HBox spacing="10.0" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                     <Button text="Clear" onAction="#handleClear" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 4;" />
                     <Button text="Save" onAction="#handleSave" fx:id="btnSave" />
                 </HBox>
                 <Label fx:id="lblMessage" textFill="RED" wrapText="true" />
             </children>
          </VBox>
      </HBox>
   </children>
</VBox>
