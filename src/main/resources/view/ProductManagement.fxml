<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800.0" prefWidth="950.0" spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stockmaster.controller.ProductController">
   <children>
      <Label styleClass="header-label" text="Product Management" />
      
      <!-- Toolbar -->
      <HBox spacing="10.0" alignment="CENTER_LEFT">
         <children>
             <TextField fx:id="txtSearch" promptText="Search by name or category..." prefWidth="300" />
             <Button text="Search" onAction="#handleSearch" />
             <Button text="Refresh" onAction="#handleRefresh" />
             <Button text="Export PDF" onAction="#handleExportPDF" />
             <HBox HBox.hgrow="ALWAYS" /> <!-- Spacer -->
             <Button text="Delete Selected" onAction="#handleDelete" style="-fx-background-color: #d70000;" />
         </children>
      </HBox>

      <!-- Main Content Split -->
      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
          <!-- Table -->
          <TableView fx:id="tableProducts" HBox.hgrow="ALWAYS">
              <columns>
                  <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                  <TableColumn fx:id="colName" text="Name" prefWidth="150" />
                  <TableColumn fx:id="colPreferencia" text="Category" prefWidth="100" />
                  <TableColumn fx:id="colSupplier" text="Supplier" prefWidth="100" />
                  <TableColumn fx:id="colPriceBuy" text="Buy Price" prefWidth="80" />
                  <TableColumn fx:id="colPriceSell" text="Sell Price" prefWidth="80" />
                  <TableColumn fx:id="colStock" text="Stock" prefWidth="80" />
                  <TableColumn fx:id="colStockMin" text="Min Stock" prefWidth="80" />
              </columns>
              <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
              </columnResizePolicy>
          </TableView>

          <!-- Edit Form -->
          <VBox spacing="10.0" prefWidth="320.0" styleClass="card" style="-fx-padding: 15;">
             <children>
                 <Label text="Product Details" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                 
                 <Label text="Name" />
                 <TextField fx:id="txtName" />
                 
                 <Label text="Description" />
                 <TextArea fx:id="txtDescription" prefHeight="60.0" wrapText="true" />
                 
                 <Label text="Category" />
                 <ComboBox fx:id="comboCategory" prefWidth="300.0" />
                 
                 <Label text="Supplier" />
                 <ComboBox fx:id="comboSupplier" prefWidth="300.0" />
                 
                 <HBox spacing="10.0">
                     <VBox HBox.hgrow="ALWAYS">
                         <Label text="Buy Price" />
                         <TextField fx:id="txtPriceBuy" />
                     </VBox>
                     <VBox HBox.hgrow="ALWAYS">
                         <Label text="Sell Price" />
                         <TextField fx:id="txtPriceSell" />
                     </VBox>
                 </HBox>
                 
                 <HBox spacing="10.0">
                     <VBox HBox.hgrow="ALWAYS">
                         <Label text="Current Stock" />
                         <TextField fx:id="txtStockCurrent" text="0" />
                     </VBox>
                     <VBox HBox.hgrow="ALWAYS">
                         <Label text="Min Stock" />
                         <TextField fx:id="txtStockMin" text="5" />
                     </VBox>
                 </HBox>

                 <HBox spacing="10.0" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                     <Button text="Clear" onAction="#handleClear" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 4;" />
                     <Button text="Save Product" onAction="#handleSave" fx:id="btnSave" />
                 </HBox>
                 <Label fx:id="lblMessage" textFill="RED" wrapText="true" />
             </children>
          </VBox>
      </HBox>
   </children>
</VBox>
