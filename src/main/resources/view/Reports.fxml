<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Priority?>

<VBox spacing="12.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stockmaster.controller.ReportsController">
   <children>
      <!-- Header -->
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Label text="%report.title" styleClass="header-label" />
            <HBox HBox.hgrow="ALWAYS" />
            <Label fx:id="lblMessage" />
         </children>
      </HBox>

      <!-- Filters -->
      <HBox spacing="12.0" alignment="CENTER_LEFT">
         <children>
            <Label text="%report.type" />
            <ComboBox fx:id="comboReportType" prefWidth="200" />
            <Label text="%report.from" />
            <DatePicker fx:id="dateFrom" prefWidth="130" />
            <Label text="%report.to" />
            <DatePicker fx:id="dateTo" prefWidth="130" />
            <Button text="%report.generate" onAction="#handleGenerate" styleClass="button, btn-sm" />
         </children>
      </HBox>

      <!-- Summary Cards -->
      <HBox spacing="12.0">
         <children>
            <VBox styleClass="card" style="-fx-padding: 12;" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="%report.total_records" styleClass="kpi-label" />
                  <Label fx:id="lblTotalRecords" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
               </children>
            </VBox>
            <VBox styleClass="card" style="-fx-padding: 12;" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="%report.total_value" styleClass="kpi-label" />
                  <Label fx:id="lblTotalValue" text="0.00" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
               </children>
            </VBox>
            <VBox styleClass="card" style="-fx-padding: 12;" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="%report.average" styleClass="kpi-label" />
                  <Label fx:id="lblAverage" text="0.00" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Data Table (dynamic columns) -->
      <TableView fx:id="tableReport" VBox.vgrow="ALWAYS">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>

      <!-- Export buttons -->
      <HBox spacing="8.0" alignment="CENTER_RIGHT">
         <children>
            <Button text="%report.export_pdf" onAction="#handleExportPDF" styleClass="button, btn-sm" />
            <Button text="%report.export_excel" onAction="#handleExportExcel" styleClass="button, btn-sm" />
         </children>
      </HBox>
   </children>
</VBox>
