<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Priority?>

<VBox spacing="12.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stockmaster.controller.SalesController">
   <children>
      <!-- Header -->
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Label text="%sales.title" styleClass="header-label" />
            <HBox HBox.hgrow="ALWAYS" />
            <Label fx:id="lblMessage" />
         </children>
      </HBox>

      <!-- Main Content -->
      <HBox spacing="16.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- Left: Product search + Cart -->
            <VBox spacing="12.0" HBox.hgrow="ALWAYS">
               <children>
                  <!-- Search bar -->
                  <HBox spacing="8.0" alignment="CENTER_LEFT">
                     <children>
                        <TextField fx:id="txtSearch" promptText="%sales.search" HBox.hgrow="ALWAYS" onAction="#handleProductSearch" />
                        <Button text="%product.search_btn" onAction="#handleProductSearch" styleClass="button, btn-sm" />
                     </children>
                  </HBox>

                  <!-- Products found -->
                  <TableView fx:id="tableSearchResults" prefHeight="180.0" VBox.vgrow="SOMETIMES">
                     <columns>
                        <TableColumn fx:id="colSearchName" text="%product.name" prefWidth="200" />
                        <TableColumn fx:id="colSearchPrice" text="%product.sell_price" prefWidth="80" />
                        <TableColumn fx:id="colSearchStock" text="%product.stock" prefWidth="70" />
                        <TableColumn fx:id="colSearchTax" text="IVA %" prefWidth="60" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>

                  <!-- Add to cart -->
                  <HBox spacing="8.0" alignment="CENTER_LEFT">
                     <children>
                        <Label text="%sales.qty" />
                        <Spinner fx:id="spinnerQty" prefWidth="80" />
                        <Button text="%sales.add_cart" onAction="#handleAddToCart" styleClass="button, btn-sm" />
                     </children>
                  </HBox>

                  <!-- Cart -->
                  <Label text="%sales.cart" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                  <TableView fx:id="tableCart" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colCartProduct" text="%product.name" prefWidth="200" />
                        <TableColumn fx:id="colCartQty" text="%sales.qty" prefWidth="50" />
                        <TableColumn fx:id="colCartPrice" text="%product.sell_price" prefWidth="80" />
                        <TableColumn fx:id="colCartTax" text="IVA %" prefWidth="60" />
                        <TableColumn fx:id="colCartTotal" text="Total" prefWidth="90" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>

                  <HBox spacing="8.0">
                     <children>
                        <Button text="%sales.remove" onAction="#handleRemoveFromCart" styleClass="button, btn-danger, btn-sm" />
                        <Button text="%sales.clear_cart" onAction="#handleClearCart" styleClass="button, btn-outline, btn-sm" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Right: Payment panel -->
            <VBox spacing="12.0" minWidth="280" maxWidth="320" styleClass="card" style="-fx-padding: 16;">
               <children>
                  <Label text="%sales.payment_summary" style="-fx-font-weight: bold; -fx-font-size: 16px;" />

                  <HBox spacing="8.0" alignment="CENTER_LEFT">
                     <children>
                        <Label text="%sales.subtotal" minWidth="80" />
                        <Label fx:id="lblSubtotal" text="0.00" style="-fx-font-size: 14px;" />
                     </children>
                  </HBox>
                  <HBox spacing="8.0" alignment="CENTER_LEFT">
                     <children>
                        <Label text="%sales.tax" minWidth="80" />
                        <Label fx:id="lblTax" text="0.00" style="-fx-font-size: 14px;" />
                     </children>
                  </HBox>
                  <HBox spacing="8.0" alignment="CENTER_LEFT">
                     <children>
                        <Label text="%sales.total" minWidth="80" style="-fx-font-weight: bold;" />
                        <Label fx:id="lblTotal" text="0.00" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #00d764;" />
                     </children>
                  </HBox>

                  <Separator />

                  <Label text="%sales.payment" />
                  <ComboBox fx:id="comboPayment" prefWidth="240" />

                  <Region VBox.vgrow="ALWAYS" />

                  <Button text="%sales.complete" onAction="#handleCompleteSale" prefWidth="240" prefHeight="44"
                          styleClass="button, btn-sm" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                  <Button text="%sales.print_receipt" onAction="#handlePrintReceipt" prefWidth="240" styleClass="button, btn-outline, btn-sm" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Sale History -->
      <TitledPane text="%sales.recent" expanded="false">
         <content>
            <VBox spacing="8.0">
               <children>
                  <TableView fx:id="tableSales" prefHeight="180.0">
                     <columns>
                        <TableColumn fx:id="colSaleId" text="ID" prefWidth="50" />
                        <TableColumn fx:id="colSaleDate" text="%report.from" prefWidth="140" />
                        <TableColumn fx:id="colSaleUser" text="%user.username" prefWidth="100" />
                        <TableColumn fx:id="colSaleSubtotal" text="%sales.subtotal" prefWidth="80" />
                        <TableColumn fx:id="colSaleTax" text="%sales.tax" prefWidth="70" />
                        <TableColumn fx:id="colSaleTotal" text="Total" prefWidth="80" />
                        <TableColumn fx:id="colSalePayment" text="%sales.payment" prefWidth="80" />
                        <TableColumn fx:id="colSaleStatus" text="%batch.status" prefWidth="80" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </content>
      </TitledPane>
   </children>
</VBox>
