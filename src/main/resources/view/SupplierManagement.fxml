<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Priority?>

<VBox spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stockmaster.controller.SupplierController">
   <children>
      <Label styleClass="header-label" text="%supplier.title" />
      
      <!-- Toolbar -->
      <HBox spacing="10.0" alignment="CENTER_LEFT">
         <children>
             <Button text="%product.refresh" onAction="#handleRefresh" styleClass="button, btn-outline" />
             <HBox HBox.hgrow="ALWAYS" />
             <Button text="%user.delete" onAction="#handleDelete" styleClass="button, btn-danger" />
         </children>
      </HBox>

      <!-- Main Content Split -->
      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
          <!-- Table -->
          <TableView fx:id="tableSuppliers" HBox.hgrow="ALWAYS">
              <columns>
                  <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                  <TableColumn fx:id="colName" text="%supplier.name" prefWidth="150" />
                  <TableColumn fx:id="colContact" text="%supplier.contact" prefWidth="150" />
                  <TableColumn fx:id="colPhone" text="%supplier.phone" prefWidth="100" />
                  <TableColumn fx:id="colEmail" text="%supplier.email" prefWidth="150" />
              </columns>
              <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
              </columnResizePolicy>
          </TableView>

          <!-- Edit Form -->
          <VBox spacing="10.0" minWidth="260" maxWidth="340" prefWidth="300.0" styleClass="card" style="-fx-padding: 18;">
             <children>
                 <Label text="%supplier.title" style="-fx-font-weight: bold; -fx-font-size: 15px;" />
                 
                 <Label text="%supplier.name" styleClass="kpi-label" />
                 <TextField fx:id="txtName" promptText="%supplier.name" />
                 
                 <Label text="%supplier.contact" styleClass="kpi-label" />
                 <TextField fx:id="txtContact" promptText="%supplier.contact" />
                 
                 <Label text="%supplier.phone" styleClass="kpi-label" />
                 <TextField fx:id="txtPhone" promptText="555-1234" />

                 <Label text="%supplier.email" styleClass="kpi-label" />
                 <TextField fx:id="txtEmail" promptText="email@example.com" />
                 
                 <HBox spacing="10.0" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                     <Button text="%product.clear" onAction="#handleClear" styleClass="button, btn-outline" />
                     <Button text="%product.save" onAction="#handleSave" fx:id="btnSave" />
                 </HBox>
                 <Label fx:id="lblMessage" wrapText="true" />
             </children>
          </VBox>
      </HBox>
   </children>
</VBox>
